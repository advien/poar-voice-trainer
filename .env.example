# ──────────────────────────────────────────────────────────────
# POAR Voice Trainer — environment variables
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local`.
# ──────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used by route handlers for privileged writes. DO NOT expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — used for BOTH speech-to-text (Whisper) and feedback.
# This is the only key required to make transcript + feedback work.
OPENAI_API_KEY=sk-...

# Optional: chat model used for feedback (default: gpt-4o-mini).
# Bump to gpt-4o for higher-quality feedback at higher cost.
FEEDBACK_MODEL=gpt-4o-mini

# ──────────────────────────────────────────────────────────────
# Access gate (src/lib/access.ts)
# ──────────────────────────────────────────────────────────────
# Free runs per visitor before the gate closes. Default: 1.
FREE_ATTEMPTS=1
# Salt for the visitor hash. Change it to reset everyone's count.
ACCESS_SALT=change-me
# Anyone sending this code (POST /api/access) bypasses the gate. Leave unset
# to disable codes entirely.
ACCESS_CODE=
